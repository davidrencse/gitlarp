# Register an OAuth app at https://github.com/settings/developers
# Homepage: http://localhost:5173
# Authorization callback: http://localhost:5173/auth/github/callback
# GitHub OAuth app client id (leave empty to use a token or the local CLI instead).
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret (server only).
GITHUB_CLIENT_SECRET=
# Local app only, opt-in: lets any process on this computer use your GitHub CLI login. Prefer a fine-grained token. Disabled in production.
GITHUB_LOCAL_AUTH=0
# Optional source-aware analysis, documentation and project Q&A. Server only.
# Groq API key (leave empty to disable AI features).
GROQ_API_KEY=
# GPT-OSS 120B handles analysis, Q&A and document generation by default.
# Model that writes generated documents.
GROQ_MODEL=openai/gpt-oss-120b
# Optional model override for analysis and Q&A.
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
# Maximum sampled source characters (16,000–160,000); default 48,000.
# Source character budget.
GROQ_CONTEXT_CHARS=48000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Public address of the web app (the only allowed origin).
APP_URL=http://localhost:5173
# Port for the API server.
PORT=3001
# For containers only: HOST=0.0.0.0
# In production: NODE_ENV=production, APP_URL=https://your-domain.example
# Only when an HTTPS reverse proxy runs on this same host:
# TRUST_PROXY=loopback
# For other deployments, explicitly allow only the proxy's IP or subnet.
